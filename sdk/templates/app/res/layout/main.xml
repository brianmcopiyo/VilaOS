<?xml version="1.0"?>
<screen id="example" class="page">
  <statusbar id="status"/>
  <flex id="body" class="col gap-8 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="example" class="text-primary" width="100%" height="wrap"/>
    <card class="p-14">
      <label id="hint" text="Hello from example" class="text-secondary" width="100%" height="wrap"/>
    </card>
    <button id="ok_btn" variant="primary" text="OK" action="ok" width="100%" height="40"/>
  </flex>
  <softkeys left="Menu" center="OK" right="Back"
            left-action="ok" center-action="ok" right-action="route:pop"/>
</screen>
