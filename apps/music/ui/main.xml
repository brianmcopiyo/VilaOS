<?xml version="1.0"?>
<screen id="music" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="8" align="stretch">
    <label id="title" text="Music" color="#1C1917" width="100%" height="wrap"/>
    <label id="now_playing" text="Stopped" color="#1C1917" width="100%" height="wrap" value="1"/>
    <label id="svc_state" text="service: idle" color="#57534E" width="100%" height="wrap" value="1"/>
    <label id="help" text="Playback continues in background" color="#57534E" width="100%" height="wrap"/>
    <hbox id="btns" width="100%" height="auto" gap="6">
      <button id="btn_play" text="Play" action="music_play" background="#EA580C" color="#FFFFFF" width="auto" height="40" radius="10" grow="1"/>
      <button id="btn_pause" text="Pause" action="music_pause" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="btn_skip" text="Skip" action="music_skip" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
    </hbox>
    <button id="btn_stop_svc" text="Stop service" action="music_stop_svc" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10"/>
  </flex>
  <softkeys left="Play" center="OK" right="Back"
            left-action="music_play" center-action="ok" right-action="route:pop"/>
</screen>
