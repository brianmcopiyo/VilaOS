<?xml version="1.0"?>
<screen id="contact_detail" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="8" align="stretch">
    <label id="name" text="Alice Chen" color="#1C1917" width="100%" height="40" value="1"/>
    <label id="role" text="Mobile" color="#57534E" width="100%" height="wrap" component="section_header"/>
    <label id="number" text="555-0101" color="#1C1917" width="100%" height="wrap"/>
    <label id="email" text="alice@vila.os" color="#57534E" width="100%" height="wrap"/>
    <button id="act_call" text="Call" action="call" background="#15803D" color="#FFFFFF" width="100%" height="40" radius="10"/>
    <button id="act_msg" text="Message" action="route:push:res/layout/compose.xml" background="#EA580C" color="#FFFFFF" width="100%" height="40" radius="10"/>
  </flex>
  <softkeys left="Call" center="Message" right="Back"
            left-action="call"
            center-action="route:push:res/layout/compose.xml"
            right-action="route:pop"/>
</screen>
