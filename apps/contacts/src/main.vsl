on_load
  require contacts
end

on_click c1
  push_route res/layout/detail.xml
end
on_click c2
  push_route res/layout/detail.xml
end
on_click c3
  push_route res/layout/detail.xml
end
on_click c4
  push_route res/layout/detail.xml
end
on_click c5
  push_route res/layout/detail.xml
end

on_soft left
  action call
end

on_soft right
  pop_route
end
