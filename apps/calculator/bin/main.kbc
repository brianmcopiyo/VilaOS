fn show
  if ne $g_cur ""
    ui.set_text calc_display $g_cur
  else
    ui.set_text calc_display $g_acc
  endif
  if ne $g_op ""
    concat _t0 $g_acc " "
    concat _t1 $_t0 $g_op
    ui.set_text calc_expr $_t1
  else
    ui.set_text calc_expr ""
  endif
endfn

fn pushDigit d
  if eq $g_fresh 1
    let g_cur $d
    let g_fresh 0
    let g_dot 0
  else
    concat g_cur $g_cur $d
  endif
  invoke show _
endfn

fn applyOp next
  if ne $g_cur ""
    if eq $g_op "+"
      toint _t2 $g_acc
      toint _t3 $g_cur
      add _t4 $_t2 $_t3
      tostr g_acc $_t4
    else
      if eq $g_op -
        toint _t2 $g_acc
        toint _t3 $g_cur
        sub _t4 $_t2 $_t3
        tostr g_acc $_t4
      else
        if eq $g_op "*"
          toint _t2 $g_acc
          toint _t3 $g_cur
          mul _t4 $_t2 $_t3
          tostr g_acc $_t4
        else
          if eq $g_op /
            toint _t2 $g_cur
            if ne $_t2 0
              toint _t3 $g_acc
              toint _t4 $g_cur
              div _t5 $_t3 $_t4
              tostr g_acc $_t5
            endif
          else
            let g_acc $g_cur
          endif
        endif
      endif
    endif
    let g_cur ""
  endif
  if eq $next "="
    let g_op ""
    let g_fresh 1
    let g_dot 0
  else
    let g_op $next
    let g_fresh 1
    let g_dot 0
  endif
  invoke show _
endfn

fn clearAll
  let g_acc 0
  let g_cur ""
  let g_op ""
  let g_fresh 1
  let g_dot 0
  invoke show _
endfn

on_load
  if eq $g_acc ""
    let g_acc 0
  endif
  if eq $g_fresh ""
    let g_fresh 1
  endif
  if eq $g_dot ""
    let g_dot 0
  endif
  require ui
  require system.device
  invoke show _
end

on_action calc:clear
  invoke clearAll _
end

on_action calc:eq
  invoke applyOp _ "="
end

on_action calc:+
  invoke applyOp _ "+"
end

on_action calc:-
  invoke applyOp _ -
end

on_action calc:*
  invoke applyOp _ "*"
end

on_action calc:/
  invoke applyOp _ /
end

on_action calc:d:0
  invoke pushDigit _ 0
end

on_action calc:d:1
  invoke pushDigit _ 1
end

on_action calc:d:2
  invoke pushDigit _ 2
end

on_action calc:d:3
  invoke pushDigit _ 3
end

on_action calc:d:4
  invoke pushDigit _ 4
end

on_action calc:d:5
  invoke pushDigit _ 5
end

on_action calc:d:6
  invoke pushDigit _ 6
end

on_action calc:d:7
  invoke pushDigit _ 7
end

on_action calc:d:8
  invoke pushDigit _ 8
end

on_action calc:d:9
  invoke pushDigit _ 9
end

on_action calc:dot
  if eq $g_fresh 1
    let g_cur 0.
    let g_fresh 0
    let g_dot 1
  else
    if eq $g_dot 0
      concat g_cur $g_cur .
      let g_dot 1
    endif
  endif
  invoke show _
end

on_soft left
  invoke clearAll _
end

on_soft center
  invoke applyOp _ "="
end

on_soft right
  ui.pop
end
