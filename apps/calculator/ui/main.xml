<?xml version="1.0"?>
<screen id="calculator" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="6" align="stretch">
    <label id="calc_expr" text="" color="#57534E" width="100%" height="wrap"/>
    <label id="calc_display" text="0" color="#1C1917" width="100%" height="48" value="1" background="#EAE0D0" radius="10" padding="8"/>
    <hbox id="r1" width="100%" height="auto" gap="6">
      <button id="c7" text="7" action="calc:d:7" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="c8" text="8" action="calc:d:8" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="c9" text="9" action="calc:d:9" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="cdiv" text="/" action="calc:/" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
    </hbox>
    <hbox id="r2" width="100%" height="auto" gap="6">
      <button id="c4" text="4" action="calc:d:4" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="c5" text="5" action="calc:d:5" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="c6" text="6" action="calc:d:6" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="cmul" text="*" action="calc:*" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
    </hbox>
    <hbox id="r3" width="100%" height="auto" gap="6">
      <button id="c1" text="1" action="calc:d:1" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="c2" text="2" action="calc:d:2" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="c3" text="3" action="calc:d:3" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="csub" text="-" action="calc:-" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
    </hbox>
    <hbox id="r4" width="100%" height="auto" gap="6">
      <button id="c0" text="0" action="calc:d:0" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="cdot" text="." action="calc:dot" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="ceq" text="=" action="calc:eq" background="#EA580C" color="#FFFFFF" width="auto" height="40" radius="10" grow="1"/>
      <button id="cadd" text="+" action="calc:+" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
    </hbox>
  </flex>
  <softkeys left="Clear" center="=" right="Back"
            left-action="calc:clear" center-action="calc:eq" right-action="route:pop"/>
</screen>
