<?xml version="1.0"?>
<screen id="calculator" bg="#F5EFE6">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="calc_expr" text="" fg="#57534E" w="100%" h="auto"/>
    <label id="calc_display" text="0" fg="#1C1917" w="100%" h="14%" value="1"/>
    <hbox id="r1" w="100%" h="auto">
      <button id="c7" text="7" action="calc:d:7" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="c8" text="8" action="calc:d:8" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="c9" text="9" action="calc:d:9" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="cdiv" text="/" action="calc:/" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
    </hbox>
    <hbox id="r2" w="100%" h="auto">
      <button id="c4" text="4" action="calc:d:4" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="c5" text="5" action="calc:d:5" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="c6" text="6" action="calc:d:6" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="cmul" text="*" action="calc:*" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
    </hbox>
    <hbox id="r3" w="100%" h="auto">
      <button id="c1" text="1" action="calc:d:1" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="c2" text="2" action="calc:d:2" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="c3" text="3" action="calc:d:3" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="csub" text="-" action="calc:-" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
    </hbox>
    <hbox id="r4" w="100%" h="auto">
      <button id="c0" text="0" action="calc:d:0" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="cdot" text="." action="calc:dot" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="ceq" text="=" action="calc:eq" bg="#EA580C" fg="#FFFFFF" focus_bg="#EA580C" w="auto" h="auto"/>
      <button id="cadd" text="+" action="calc:+" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C" w="auto" h="auto"/>
    </hbox>
  </vbox>
  <softkeys left="Clear" center="=" right="Back"
            left_action="calc:clear" center_action="calc:eq" right_action="route:pop"/>
</screen>
