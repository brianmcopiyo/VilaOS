<?xml version="1.0"?>
<screen id="settings_input" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Input" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <label id="inp_devices" text="Devices" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="inp_feedback" text="Feedback: ready" color="#57534E" width="100%" height="wrap" font-family="JetBrains Mono" font-size="11"/>
      <label id="inp_mode" text="Key mode: ABC" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="inp_nav" text="Nav: Softkeys + focus" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
    </card>
    <header id="inp_sec_test" text="Live test"/>
    <button id="inp_btn_tap" text="Tap / click test" icon="mouse-pointer" icon-set="lucide" action="inp_tap" background="#EA580C" color="#FFFFFF" width="100%" height="44" radius="10" component="button"/>
    <button id="inp_btn_mode" text="Cycle key mode" icon="keyboard" icon-set="lucide" action="inp_cycle_mode" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <button id="inp_btn_scroll" text="Cycle scroll" icon="move-vertical" icon-set="lucide" action="inp_cycle_scroll" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <label id="inp_help" text="Each tap updates live feedback without leaving Settings" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
  </flex>
  <softkeys left="Tap" center="OK" right="Back"
            left-action="inp_tap" center-action="ok" right-action="route:pop"/>
</screen>
