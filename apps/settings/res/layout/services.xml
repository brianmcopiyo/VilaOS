<?xml version="1.0"?>
<screen id="settings_services" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Services" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <row id="svc_music_row" title="musicd" subtitle="Audio background" icon="music" icon-set="phosphor"/>
      <label id="svc_music_state" text="service: idle" color="#57534E" width="100%" height="wrap" font-family="JetBrains Mono" font-size="11"/>
    </card>
    <hbox id="svc_btns" width="100%" height="auto" gap="6">
      <button id="btn_svc_start" text="Start" action="svc_start" background="#EA580C" color="#FFFFFF" width="auto" height="40" radius="10" grow="1" component="button"/>
      <button id="btn_svc_stop" text="Stop" action="svc_stop" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1" component="button"/>
      <button id="btn_svc_refresh" text="Status" action="svc_refresh" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1" component="button"/>
    </hbox>
    <header id="sec_note" text="Notes"/>
    <label id="svc_help" text="Only eligible services can be started or stopped. Shell PID 1 stays protected." color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
  </flex>
  <softkeys left="Start" center="OK" right="Back"
            left-action="svc_start" center-action="ok" right-action="route:pop"/>
</screen>
