<?xml version="1.0"?>
<screen id="settings" bg="#0B0F17">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="title" text="Settings" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="sec_display" text="Display" fg="#94A3B8" w="100%" h="auto"/>
    <button id="toggle_text" text="Large text: Off" action="toggle_text" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF" w="100%" h="auto"/>
    <label id="sec_input" text="Input and keypad" fg="#94A3B8" w="100%" h="auto"/>
    <label id="input_help" text="T9, 123, and QWERTY supported" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="sec_sound" text="Sound and profiles" fg="#94A3B8" w="100%" h="auto"/>
    <button id="toggle_sound" text="Sound: On" action="toggle_sound" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF" w="100%" h="auto"/>
    <button id="toggle_vibrate" text="Vibrate: On" action="toggle_vibrate" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF" w="100%" h="auto"/>
    <button id="toggle_profile" text="Profile: General" action="cycle_profile" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF" w="100%" h="auto"/>
    <label id="sec_time" text="Date and time" fg="#94A3B8" w="100%" h="auto"/>
    <label id="time_help" text="Uses device clock automatically" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="sec_about" text="About VilaOS" fg="#94A3B8" w="100%" h="auto"/>
    <label id="about1" text="VilaOS Feature Phone" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="about2" text="Version 1.0" fg="#94A3B8" w="100%" h="auto"/>
  </vbox>
  <softkeys left="Toggle" center="OK" right="Back"
            left_action="ok" center_action="ok" right_action="back"/>
</screen>
