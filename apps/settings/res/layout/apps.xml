<?xml version="1.0"?>
<screen id="settings_apps" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Apps" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="row items-center justify-between p-8">
      <row id="apps_summary" title="Installed" subtitle="Scanning packages" icon="package" icon-set="lucide"/>
      <badge id="apps_count" text="0"/>
    </card>
    <list id="pkg_list" width="100%" height="fill" grow="1" min-height="120" class="surface" padding="4" gap="4" overflow="scroll">
      <row id="pkg0" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_0"/>
      <row id="pkg1" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_1"/>
      <row id="pkg2" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_2"/>
      <row id="pkg3" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_3"/>
      <row id="pkg4" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_4"/>
      <row id="pkg5" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_5"/>
      <row id="pkg6" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_6"/>
      <row id="pkg7" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_7"/>
      <row id="pkg8" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_8"/>
      <row id="pkg9" title="—" subtitle="—" icon="app" icon-set="lucide" action="pkg_9"/>
    </list>
    <button id="btn_refresh_apps" text="Refresh packages" icon="refresh-cw" icon-set="lucide" action="refresh_apps" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
  </flex>
  <softkeys left="Refresh" center="Open" right="Back"
            left-action="refresh_apps" center-action="ok" right-action="route:pop"/>
</screen>
