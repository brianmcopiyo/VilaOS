<?xml version="1.0"?>
<screen id="settings_display" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Display" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <label id="disp_res" text="Resolution" color="#1C1917" width="100%" height="wrap" font-family="JetBrains Mono" font-size="12"/>
      <label id="disp_adapt" text="Containers adapt; glyphs stay 1:1 px" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
      <label id="disp_theme" text="Theme: Sunset Orange" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="disp_font" text="Text: Normal" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
    </card>
    <header id="disp_sec_theme" text="Theme and accent"/>
    <button id="disp_btn_sunset" text="Sunset Orange #EA580C" icon="sun" icon-set="lucide" action="disp_theme_sunset" background="#EA580C" color="#FFFFFF" width="100%" height="40" radius="10" component="button"/>
    <button id="disp_btn_beige" text="Warm Beige #F5EFE6" icon="palette" icon-set="lucide" action="disp_theme_beige" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <button id="disp_btn_text" text="Text size: Normal" icon="type" icon-set="lucide" action="disp_toggle_text" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <button id="disp_btn_icon" text="Icon set: Lucide" icon="shapes" icon-set="lucide" action="disp_cycle_icons" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <header id="disp_sec_preview" text="Preview"/>
    <card class="row items-center justify-between p-8">
      <row id="disp_preview_row" title="Sample row" subtitle="Icon and type preview" icon="sparkles" icon-set="lucide"/>
      <badge id="disp_preview_badge" text="Live" icon="check" icon-set="lucide"/>
    </card>
  </flex>
  <softkeys left="Theme" center="OK" right="Back"
            left-action="disp_theme_cycle" center-action="ok" right-action="route:pop"/>
</screen>
