<?xml version="1.0"?>
<screen id="settings_system" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="System" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <label id="sys_device" text="Device" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="sys_memory" text="Memory" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="sys_storage" text="Storage" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="sys_api" text="API" color="#1C1917" width="100%" height="wrap" font-family="JetBrains Mono" font-size="12"/>
      <label id="sys_locale" text="Locale" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="sys_time" text="Time" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
    </card>
    <header id="sec_power" text="Power"/>
    <button id="btn_power_menu" text="Power menu" icon="power" icon-set="lucide" action="power_menu" background="#EA580C" color="#FFFFFF" width="100%" height="40" radius="10" component="button"/>
    <button id="btn_restart" text="Restart" icon="rotate-cw" icon-set="lucide" action="power_restart" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <label id="power_help" text="Back stays in Settings until the root stack frame. PID 1 is never stopped." color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
  </flex>
  <softkeys left="Power" center="OK" right="Back"
            left-action="power_menu" center-action="ok" right-action="route:pop"/>
</screen>
