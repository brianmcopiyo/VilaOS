fn themeLabel theme
  if eq $theme 1
    ret "Warm Beige"
  endif
  ret "Sunset Orange"
endfn

fn textLabel large
  if eq $large 1
    ret Large
  endif
  ret Normal
endfn

fn iconLabel set
  if eq $set 1
    ret Tabler
  endif
  if eq $set 2
    ret Phosphor
  endif
  ret Lucide
endfn

fn refreshDisplay theme large icons
  system.display.info disp_res
  system.theme disp_theme
  invoke themeLabel _t0 $theme
  concat _t1 "Theme: " $_t0
  ui.set_text disp_theme $_t1
  invoke textLabel _t0 $large
  concat _t1 "Text: " $_t0
  ui.set_text disp_font $_t1
  ui.set_text disp_adapt "Containers adapt; glyphs stay 1:1 px"
  invoke textLabel _t0 $large
  concat _t1 "Text size: " $_t0
  ui.set_text disp_btn_text $_t1
  invoke iconLabel _t0 $icons
  concat _t1 "Icon set: " $_t0
  ui.set_text disp_btn_icon $_t1
  invoke textLabel _t0 $large
  concat _t1 "Sample " $_t0
  ui.set_text disp_preview_row $_t1
  invoke themeLabel _t0 $theme
  ui.set_text disp_preview_badge $_t0
  storage.app.set theme $theme
  storage.app.set large_text $large
  storage.app.set icon_set $icons
endfn

fn keyLabel mode
  if eq $mode 1
    ret T9
  endif
  if eq $mode 2
    ret 123
  endif
  ret ABC
endfn

fn scrollLabel scroll
  if eq $scroll 1
    ret Fast
  endif
  if eq $scroll 2
    ret Precise
  endif
  ret Standard
endfn

fn refreshInput mode scroll taps
  system.input.info inp_devices
  invoke keyLabel _t2 $mode
  concat _t3 "Key mode: " $_t2
  ui.set_text inp_mode $_t3
  invoke scrollLabel _t2 $scroll
  concat _t3 "Scroll: " $_t2
  ui.set_text inp_nav $_t3
  concat _t2 "taps=" $taps
  concat _t3 $_t2 " mode="
  invoke keyLabel _t4 $mode
  concat _t5 $_t3 $_t4
  ui.set_text inp_feedback $_t5
  concat _t2 "Tap / click test (" $taps
  concat _t3 $_t2 ")"
  ui.set_text inp_btn_tap $_t3
  invoke keyLabel _t2 $mode
  concat _t3 "Cycle key mode (" $_t2
  concat _t4 $_t3 ")"
  ui.set_text inp_btn_mode $_t4
  invoke scrollLabel _t2 $scroll
  concat _t3 "Cycle scroll (" $_t2
  concat _t4 $_t3 ")"
  ui.set_text inp_btn_scroll $_t4
  storage.app.set key_mode $mode
  storage.app.set scroll $scroll
  storage.app.set taps $taps
endfn

fn refreshMain
  system.device.info hub_device
  system.api.version hub_api
  system.display.info hub_display
  system.input.info hub_input
  system.storage.info hub_packages
  system.memory.info hub_system
  ui.set_text hub_services "Services musicd"
endfn

fn searchMain
  vapi searchMain_q ui.get_text search
  if eq $searchMain_q ""
    system.device.info hub_device
  else
    concat _t6 "Filter: " $searchMain_q
    ui.set_text hub_device $_t6
    storage.app.set settings_filter $searchMain_q
  endif
endfn

fn refreshPackages
  system.packages.list pkg_summary
  system.storage.info pkg_summary
endfn

fn openDetail index
  storage.app.set pkg_sel $index
  system.packages.detail $index pkg_id
  ui.push res/layout/app_detail.xml
endfn

fn reloadDetail
  vapi reloadDetail_index storage.app.get pkg_sel
  if eq $reloadDetail_index ""
    system.packages.detail 0 pkg_id
  else
    system.packages.detail $reloadDetail_index pkg_id
  endif
endfn

fn openSelected
  vapi openSelected_index storage.app.get pkg_sel
  system.packages.detail $openSelected_index pkg_id
  vapi openSelected_id ui.get_text pkg_id
  if eq $openSelected_id ""
    ui.dialog Package "No package selected"
  else
    concat _t7 app: $openSelected_id
    action $_t7
  endif
endfn

fn refreshServices
  service.status musicd svc_music_state
  service.cmd musicd STATUS svc_music_track
  vapi refreshServices_st ui.get_text svc_music_state
  if eq $refreshServices_st ""
    ui.set_text svc_music_badge idle
  else
    ui.set_text svc_music_badge $refreshServices_st
  endif
endfn

fn startService
  service.start musicd
  invoke refreshServices _
endfn

fn stopService
  service.stop musicd
  invoke refreshServices _
endfn

fn statusService
  invoke refreshServices _
endfn

fn cmdService
  service.cmd musicd STATUS svc_music_track
  invoke refreshServices _
endfn

fn loadPrefs
  vapi loadPrefs_theme storage.app.get theme
  if ne $loadPrefs_theme ""
    let g_theme $loadPrefs_theme
  endif
  vapi loadPrefs_large storage.app.get large_text
  if ne $loadPrefs_large ""
    let g_large $loadPrefs_large
  endif
  vapi loadPrefs_icons storage.app.get icon_set
  if ne $loadPrefs_icons ""
    let g_icons $loadPrefs_icons
  endif
  vapi loadPrefs_mode storage.app.get key_mode
  if ne $loadPrefs_mode ""
    let g_key_mode $loadPrefs_mode
  endif
  vapi loadPrefs_scroll storage.app.get scroll
  if ne $loadPrefs_scroll ""
    let g_scroll $loadPrefs_scroll
  endif
  vapi loadPrefs_taps storage.app.get taps
  if ne $loadPrefs_taps ""
    let g_taps $loadPrefs_taps
  endif
endfn

fn refreshAll
  invoke refreshMain _
  invoke refreshDisplay _ $g_theme $g_large $g_icons
  invoke refreshInput _ $g_key_mode $g_scroll $g_taps
  invoke refreshPackages _
  invoke refreshServices _
  invoke refreshSystem _
endfn

fn refreshSystem
  system.device.info sys_device
  system.memory.info sys_memory
  system.storage.info sys_storage
  system.runtime.info sys_runtime
  system.api.version sys_api
  system.locale sys_locale
  system.time sys_time
endfn

fn powerMenu
  system.power.menu
endfn

fn restart
  system.power.restart
endfn

fn shutdown
  system.power.off
endfn

on_load
  if eq $g_theme ""
    let g_theme 0
  endif
  if eq $g_large ""
    let g_large 0
  endif
  if eq $g_icons ""
    let g_icons 0
  endif
  if eq $g_key_mode ""
    let g_key_mode 0
  endif
  if eq $g_scroll ""
    let g_scroll 0
  endif
  if eq $g_taps ""
    let g_taps 0
  endif
  require ui
  require system.device
  require system.power
  require storage.app
  require storage.files
  require audio.bg
  invoke loadPrefs _
  storage.asset.read about.txt disp_adapt
  invoke refreshAll _
end

on_tick
  invoke refreshSystem _
  invoke refreshServices _
end

on_action hub_search
  invoke searchMain _
end

on_action disp_theme_sunset
  let g_theme 0
  invoke refreshDisplay _ $g_theme $g_large $g_icons
  invoke refreshMain _
end

on_action disp_theme_beige
  let g_theme 1
  invoke refreshDisplay _ $g_theme $g_large $g_icons
  invoke refreshMain _
end

on_action disp_theme_cycle
  if eq $g_theme 0
    let g_theme 1
  else
    let g_theme 0
  endif
  invoke refreshDisplay _ $g_theme $g_large $g_icons
  invoke refreshMain _
end

on_action disp_toggle_text
  if eq $g_large 0
    let g_large 1
  else
    let g_large 0
  endif
  invoke refreshDisplay _ $g_theme $g_large $g_icons
end

on_action disp_cycle_icons
  toint _t8 $g_icons
  add _t9 $_t8 1
  mod _t10 $_t9 3
  tostr g_icons $_t10
  invoke refreshDisplay _ $g_theme $g_large $g_icons
end

on_action inp_tap
  toint _t8 $g_taps
  add _t9 $_t8 1
  tostr g_taps $_t9
  invoke refreshInput _ $g_key_mode $g_scroll $g_taps
end

on_action inp_cycle_mode
  toint _t8 $g_key_mode
  add _t9 $_t8 1
  mod _t10 $_t9 3
  tostr g_key_mode $_t10
  invoke refreshInput _ $g_key_mode $g_scroll $g_taps
  invoke refreshMain _
end

on_action inp_cycle_scroll
  toint _t8 $g_scroll
  add _t9 $_t8 1
  mod _t10 $_t9 3
  tostr g_scroll $_t10
  invoke refreshInput _ $g_key_mode $g_scroll $g_taps
end

on_action pkg_refresh
  invoke refreshPackages _
end

on_action pkg_0
  invoke openDetail _ 0
end

on_action pkg_1
  invoke openDetail _ 1
end

on_action pkg_2
  invoke openDetail _ 2
end

on_action pkg_3
  invoke openDetail _ 3
end

on_action pkg_4
  invoke openDetail _ 4
end

on_action pkg_5
  invoke openDetail _ 5
end

on_action pkg_6
  invoke openDetail _ 6
end

on_action pkg_7
  invoke openDetail _ 7
end

on_action pkg_8
  invoke openDetail _ 8
end

on_action pkg_9
  invoke openDetail _ 9
end

on_action pkg_open
  invoke openSelected _
end

on_action pkg_reload
  invoke reloadDetail _
end

on_action svc_start
  invoke startService _
end

on_action svc_stop
  invoke stopService _
end

on_action svc_status
  invoke statusService _
end

on_action svc_cmd
  invoke cmdService _
end

on_action sys_power_menu
  invoke powerMenu _
end

on_action sys_restart
  invoke restart _
end

on_action sys_shutdown
  invoke shutdown _
end

on_soft left
  invoke searchMain _
end

on_soft center
  invoke refreshAll _
end

on_soft right
  ui.pop
end
