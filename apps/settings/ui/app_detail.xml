<?xml version="1.0"?>
<screen id="settings_pkg_detail" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Package" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <label id="pkg_name" text="Name" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="14" font-weight="700"/>
      <label id="pkg_id" text="id" color="#57534E" width="100%" height="wrap" font-family="JetBrains Mono" font-size="11"/>
      <label id="pkg_ver" text="version" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="pkg_caps" text="capabilities" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="pkg_entry" text="entry" color="#57534E" width="100%" height="wrap" font-family="JetBrains Mono" font-size="11"/>
      <label id="pkg_icon" text="icon" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
    </card>
    <badge id="pkg_badge" text="Installed .vpkg" icon="check" icon-set="lucide"/>
    <button id="pkg_btn_open" text="Open package" icon="external-link" icon-set="lucide" action="pkg_open" background="#EA580C" color="#FFFFFF" width="100%" height="40" radius="10" component="button"/>
    <button id="pkg_btn_refresh" text="Reload metadata" icon="refresh-cw" icon-set="lucide" action="pkg_reload" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <label id="pkg_safe" text="Destructive uninstall stays in vilaos-pkg; Settings only inspects and opens" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
  </flex>
  <softkeys left="Open" center="OK" right="Back"
            left-action="pkg_open" center-action="ok" right-action="route:pop"/>
</screen>
