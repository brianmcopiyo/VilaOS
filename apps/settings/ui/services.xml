<?xml version="1.0"?>
<screen id="settings_services" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Services" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <row id="svc_music_row" title="musicd" subtitle="Audio background service" icon="music" icon-set="phosphor"/>
      <badge id="svc_music_badge" text="idle"/>
      <label id="svc_music_state" text="service: idle" color="#57534E" width="100%" height="wrap" font-family="JetBrains Mono" font-size="11"/>
      <label id="svc_music_track" text="track: —" color="#57534E" width="100%" height="wrap" font-family="JetBrains Mono" font-size="11"/>
    </card>
    <hbox id="svc_btns" width="100%" height="auto" gap="6">
      <button id="svc_btn_start" text="Start" action="svc_start" background="#EA580C" color="#FFFFFF" width="auto" height="40" radius="10" grow="1" component="button"/>
      <button id="svc_btn_stop" text="Stop" action="svc_stop" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1" component="button"/>
      <button id="svc_btn_status" text="Status" action="svc_status" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1" component="button"/>
    </hbox>
    <button id="svc_btn_cmd" text="Send STATUS command" icon="terminal" icon-set="lucide" action="svc_cmd" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <header id="svc_sec_note" text="Protection"/>
    <label id="svc_help" text="PID 1 shell is never listed or stopped. Only eligible services accept start/stop." color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
  </flex>
  <softkeys left="Start" center="OK" right="Back"
            left-action="svc_start" center-action="ok" right-action="route:pop"/>
</screen>
