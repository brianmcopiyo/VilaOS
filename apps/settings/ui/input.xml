<?xml version="1.0"?>
<screen id="settings_input" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Input" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="700" component="header"/>
    <card class="col gap-4 p-8">
      <label id="input_devices" text="Devices" color="#1C1917" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="input_mode" text="Key mode: ABC" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="input_scroll" text="Scroll: Standard" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
    </card>
    <header id="sec_test" text="Responsiveness"/>
    <button id="btn_tap_test" text="Tap test: 0" icon="mouse-pointer" icon-set="lucide" action="tap_test" background="#EA580C" color="#FFFFFF" width="100%" height="44" radius="10" component="button"/>
    <label id="tap_help" text="Press repeatedly to verify pointer and keys" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="11"/>
    <header id="sec_prefs" text="Preferences"/>
    <button id="btn_key_mode" text="Key mode: ABC" icon="keyboard" icon-set="lucide" action="cycle_key_mode" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
    <button id="btn_scroll" text="Scroll: Standard" icon="move-vertical" icon-set="lucide" action="cycle_scroll" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" component="button"/>
  </flex>
  <softkeys left="Test" center="OK" right="Back"
            left-action="tap_test" center-action="ok" right-action="route:pop"/>
</screen>
