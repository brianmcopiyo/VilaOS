<?xml version="1.0"?>
<screen id="notes" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="6" align="stretch">
    <label id="title" text="Notes" color="#1C1917" width="100%" height="wrap"/>
    <label id="mode_badge" text="T9: abc" value="2" width="auto" height="24" background="#EA580C" color="#FFFFFF" radius="12" component="badge"/>
    <list id="note_list" width="100%" height="fill" grow="1" min-height="80" padding="4" gap="4" radius="8" background="#EAE0D0" border-width="1" border-color="#D4C5B0">
      <button id="n1" text="Shopping list" action="none" background="#EAE0D0" color="#1C1917" radius="10" height="40" component="row"/>
      <button id="n2" text="Ideas" action="none" background="#EAE0D0" color="#1C1917" radius="10" height="40" component="row"/>
      <button id="n3" text="Travel plan" action="none" background="#EAE0D0" color="#1C1917" radius="10" height="40" component="row"/>
    </list>
    <input id="note" text="Write a note..." width="100%" height="56" background="#EAE0D0" color="#1C1917" radius="10" border-width="1" border-color="#D4C5B0" padding="8"/>
    <label id="note_status" text="Unsaved" color="#57534E" width="100%" height="wrap"/>
  </flex>
  <softkeys left="Save" center="OK" right="Back"
            left-action="save_note" center-action="ok" right-action="route:pop"/>
</screen>
