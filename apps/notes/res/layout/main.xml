<?xml version="1.0"?>
<screen id="notes" bg="#0B0F17">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="title" text="Notes" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="mode_badge" text="[T9: abc]" fg="#94A3B8" w="100%" h="auto"/>
    <list id="note_list" w="100%" h="30%" bg="#151C28">
      <button id="n1" text="Shopping list" action="none" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
      <button id="n2" text="Ideas" action="none" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
      <button id="n3" text="Travel plan" action="none" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
    </list>
    <input id="note" text="Write a note..." max_len="120" w="100%" h="auto" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
    <label id="note_status" text="Unsaved" fg="#94A3B8" w="100%" h="auto"/>
  </vbox>
  <softkeys left="Save" center="OK" right="Back"
            left_action="save_note" center_action="ok" right_action="back"/>
</screen>
