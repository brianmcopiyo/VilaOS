<Taskbar Background="#EAE0D0" BorderBrush="#D4C5B0" BorderThickness="1" Height="52" Padding="10,8" x:Name="DesktopTaskbar" xmlns="http://schemas.vilaos.dev/xaml">
  <Grid Columns="Auto,*,Auto" ColumnSpacing="8">
    <Button Action="home" Background="#EA580C" Content="Home" CornerRadius="10" Foreground="#FFFFFF" Padding="12,8" x:Name="HomeBtn"/>
    <Stack GridColumn="1" Orientation="Horizontal" Spacing="6" x:Name="TaskButtons">
      <Button Action="none" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="tb0"/>
      <Button Action="none" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="tb1"/>
      <Button Action="none" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="tb2"/>
      <Button Action="none" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="tb3"/>
      <Button Action="none" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="tb4"/>
      <Button Action="none" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="tb5"/>
    </Stack>
    <Button Action="wm:show_desktop" Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" Content="Desktop" CornerRadius="10" Foreground="#1C1917" Padding="12,8" x:Name="ShowDesktopBtn"/>
  </Grid>
</Taskbar>
