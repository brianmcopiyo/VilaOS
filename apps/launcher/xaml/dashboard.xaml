<Dashboard Background="#F5EFE6" Padding="24" x:Name="DesktopDashboard" xmlns="http://schemas.vilaos.dev/xaml">
  <Grid ColumnSpacing="18" Columns="*,320" RowSpacing="18" Rows="Auto,*,Auto">
    <Panel Background="#EAE0D0" BorderBrush="#D4C5B0" BorderThickness="1" CornerRadius="14" GridColumnSpan="2" Padding="18">
      <Grid Columns="*,Auto">
        <Stack Orientation="Vertical" Spacing="4">
          <Text FontSize="22" FontWeight="Bold" Foreground="#1C1917" Text="Desktop Workspace" x:Name="WorkspaceTitle"/>
          <Text FontSize="13" Foreground="#57534E" Text="Dynamic package workspace" x:Name="WorkspaceSubtitle"/>
        </Stack>
        <Stack Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Badge Background="#EA580C" CornerRadius="999" Foreground="#FFFFFF" Padding="10,4" Text="1024 MB" x:Name="SessionBadge"/>
          <Button Background="#EA580C" Content="Refresh" CornerRadius="8" Foreground="#FFFFFF" Padding="14,8" x:Name="RefreshAppsBtn"/>
        </Stack>
      </Grid>
    </Panel>
    <Card Background="#EAE0D0" BorderBrush="#D4C5B0" BorderThickness="1" CornerRadius="14" Padding="18" x:Name="QuickAppsCard">
      <Stack Orientation="Vertical" Spacing="14" Height="Fill" Grow="1">
        <Row Subtitle="Discovered from installed .vpkg packages" Title="Installed Applications" x:Name="InstalledHeaderRow"/>
        <Grid ColumnSpacing="12" Columns="*,*,*" RowSpacing="12" Height="Fill" Grow="1" x:Name="DynamicAppGrid"/>
      </Stack>
    </Card>
    <Card Background="#EAE0D0" BorderBrush="#D4C5B0" BorderThickness="1" CornerRadius="14" Padding="18" x:Name="SystemCard">
      <Stack Orientation="Vertical" Spacing="12">
        <Row Subtitle="Live host and compositor state" Title="System Overview"/>
        <List Spacing="8" x:Name="TelemetryList">
          <Row Subtitle="1024 MB allocated" Title="Memory" x:Name="RamRow"/>
          <Row Subtitle="0 installed" Title="Packages" x:Name="PackagesRow"/>
          <Row Subtitle="0 active" Title="Open Windows" x:Name="WindowsRow"/>
        </List>
      </Stack>
    </Card>
    <Panel Background="#EAE0D0" BorderBrush="#D4C5B0" BorderThickness="1" CornerRadius="12" GridColumnSpan="2" Padding="14,10">
      <Grid Columns="*,Auto">
        <Input Background="#F5EFE6" BorderBrush="#D4C5B0" BorderThickness="1" CornerRadius="8" Foreground="#1C1917" Padding="10,6" Placeholder="Filter installed apps..." x:Name="QuickSearchInput"/>
        <Text FontSize="13" Foreground="#57534E" Margin="12,0,0,0" Text="Focused: None" VerticalAlignment="Center" x:Name="ActiveWindowLabel"/>
      </Grid>
    </Panel>
  </Grid>
</Dashboard>
