<?xml version="1.0"?>
<screen id="lock" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-10 p-20" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="clock" text="00:00" color="#1C1917" width="100%" height="wrap" value="1" font-family="JetBrains Mono" font-size="48" font-weight="500" text-align="center"/>
    <label id="date" text="Today" color="#57534E" width="100%" height="wrap" font-family="DM Sans" font-size="15" font-weight="600" text-align="center"/>
    <badge id="note1" text="2 messages" value="2" background="#EA580C" color="#FFFFFF" radius="12" height="24"/>
    <badge id="note2" text="1 missed call" value="2" background="#EA580C" color="#FFFFFF" radius="12" height="24"/>
    <label id="hint" text="Swipe up or tap Unlock" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12" text-align="center"/>
    <button id="unlock" text="Unlock" action="unlock" background="#EA580C" color="#FFFFFF" width="100%" height="48" radius="24" border-width="0"/>
  </flex>
  <softkeys left="" center="" right=""
            left-action="shade" center-action="unlock" right-action="app:dialer"/>
</screen>
