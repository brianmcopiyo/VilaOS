<?xml version="1.0"?>
<screen id="lock" class="page" background="#F5EFE6">
  <flex id="shell" class="col gap-0" x="0%" y="0%" width="100%" height="fill" align-items="stretch">
    <hbox id="topbar" width="100%" height="36" gap="8" padding="6" background="#EAE0D0" border-width="0" align-items="center">
      <label id="brand" text="VilaOS" color="#1C1917" width="auto" height="wrap" font-family="DM Sans" font-size="14" font-weight="700"/>
      <label id="clock" text="00:00" color="#1C1917" width="fill" height="wrap" grow="1" value="1" font-family="JetBrains Mono" font-size="14" font-weight="500" text-align="center"/>
      <button id="unlock" text="Enter desktop" action="unlock" background="#EA580C" color="#FFFFFF" width="120" height="24" radius="8" border-width="0" component="button" font-family="Inter" font-size="12"/>
    </hbox>
    <flex id="body" class="col gap-12 p-24" width="100%" height="fill" grow="1" align-items="center" justify-content="center">
      <label id="date" text="Today" color="#57534E" width="100%" height="wrap" font-family="DM Sans" font-size="16" font-weight="600" text-align="center"/>
      <label id="hint" text="Desktop session ready" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="13" text-align="center"/>
      <button id="go" text="Open desktop" action="unlock" background="#EA580C" color="#FFFFFF" width="200" height="40" radius="10" border-width="0" component="button" font-family="Inter" font-size="14"/>
    </flex>
  </flex>
</screen>
