<?xml version="1.0"?>
<screen id="shade" class="page" background="#F5EFE6">
  <flex id="shell" class="col gap-0" x="0%" y="0%" width="100%" height="fill" align-items="stretch">
    <hbox id="topbar" width="100%" height="36" gap="8" padding="6" background="#EAE0D0" border-width="0" align-items="center">
      <button id="back" text="Back" icon="arrow-left" icon-set="lucide" action="route:pop" background="#F5EFE6" color="#1C1917" width="72" height="24" radius="8" border-width="0" component="button" font-family="Inter" font-size="12"/>
      <label id="title" text="Quick settings" color="#1C1917" width="fill" height="wrap" grow="1" font-family="DM Sans" font-size="14" font-weight="700" component="header"/>
      <label id="clock" text="00:00" color="#1C1917" width="auto" height="wrap" value="1" font-family="JetBrains Mono" font-size="14"/>
    </hbox>
    <flex id="body" class="col gap-8 p-12" width="100%" height="fill" grow="1" align-items="stretch">
      <label id="device" text="Device" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <label id="memory" text="Memory" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
      <header id="toggles" text="Toggles"/>
      <button id="sound" text="Sound: On" icon="volume-2" icon-set="lucide" action="toggle_sound" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" border-width="0" component="button"/>
      <button id="vibrate" text="Vibrate: On" icon="smartphone" icon-set="lucide" action="toggle_vibrate" background="#EAE0D0" color="#1C1917" width="100%" height="40" radius="10" border-width="0" component="button"/>
      <button id="power" text="Power menu" icon="power" icon-set="lucide" action="power_menu" background="#EA580C" color="#FFFFFF" width="100%" height="40" radius="10" border-width="0" component="button"/>
    </flex>
  </flex>
</screen>
