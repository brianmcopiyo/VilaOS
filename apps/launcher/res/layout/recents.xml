<?xml version="1.0"?>
<screen id="recents" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-8 p-16" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Recents" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="20" font-weight="700" component="header"/>
    <list id="tasks" width="100%" height="fill" grow="1" min-height="160" padding="4" gap="8" overflow="scroll" background="#F5EFE6" border-width="0" radius="0">
      <row id="r0" title="—" subtitle="Not running" icon="app" icon-set="lucide" action="recent_0"/>
      <row id="r1" title="—" subtitle="Not running" icon="app" icon-set="lucide" action="recent_1"/>
      <row id="r2" title="—" subtitle="Not running" icon="app" icon-set="lucide" action="recent_2"/>
      <row id="r3" title="—" subtitle="Not running" icon="app" icon-set="lucide" action="recent_3"/>
      <row id="r4" title="—" subtitle="Not running" icon="app" icon-set="lucide" action="recent_4"/>
      <row id="r5" title="—" subtitle="Not running" icon="app" icon-set="lucide" action="recent_5"/>
    </list>
    <button id="clear" text="Clear all" icon="x" icon-set="lucide" action="clear" background="#EAE0D0" color="#1C1917" width="100%" height="44" radius="22" border-width="0" component="button" font-family="Inter" font-size="13"/>
  </flex>
  <softkeys left="" center="" right=""
            left-action="clear" center-action="home" right-action="route:pop"/>
</screen>
