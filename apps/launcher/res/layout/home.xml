      </grid>
    </flex>
    <hbox id="taskbar" width="100%" height="48" gap="6" padding="6" background="#EAE0D0" border-width="0">
      <button id="start" text="" icon="home" icon-set="lucide" action="home" background="#EA580C" color="#FFFFFF" width="36" height="36" radius="10" border-width="0" component="button"/>
