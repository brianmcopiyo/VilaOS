<?xml version="1.0"?>
<screen id="home" class="page" background="#F5EFE6">
  <flex id="shell" class="col gap-0" x="0%" y="0%" width="100%" height="fill" align-items="stretch">
    <hbox id="topbar" width="100%" height="36" gap="8" padding="6" background="#EAE0D0" border-width="0" align-items="center">
      <button id="menu" text="Apps" icon="grid" icon-set="lucide" action="route:push:res/layout/drawer.xml" background="#EA580C" color="#FFFFFF" width="88" height="24" radius="8" border-width="0" component="button" font-family="Inter" font-size="12"/>
      <label id="brand" text="VilaOS" color="#1C1917" width="auto" height="wrap" font-family="DM Sans" font-size="14" font-weight="700"/>
      <label id="clock" text="00:00" color="#1C1917" width="fill" height="wrap" grow="1" value="1" font-family="JetBrains Mono" font-size="14" font-weight="500" text-align="center"/>
      <badge id="statuspill" text="Ready" value="2" background="#EA580C" color="#FFFFFF" radius="8" height="20" width="auto"/>
      <button id="quick" text="" icon="sliders" icon-set="lucide" action="route:push:res/layout/shade.xml" background="#F5EFE6" color="#1C1917" width="28" height="24" radius="8" border-width="0" component="button"/>
      <button id="power" text="" icon="power" icon-set="lucide" action="power_menu" background="#F5EFE6" color="#1C1917" width="28" height="24" radius="8" border-width="0" component="button"/>
    </hbox>
    <flex id="body" class="col gap-8 p-12" width="100%" height="fill" grow="1" align-items="stretch">
      <label id="date" text="Today" color="#57534E" width="100%" height="wrap" font-family="DM Sans" font-size="13" font-weight="600"/>
      <grid id="launcher" width="100%" height="fill" grow="1" gap="10" padding="4" columns="6">
        <button id="tile0" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
