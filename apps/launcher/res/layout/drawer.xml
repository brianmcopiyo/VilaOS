<?xml version="1.0"?>
<screen id="drawer" class="page" background="#F5EFE6">
  <flex id="shell" class="col gap-0" x="0%" y="0%" width="100%" height="fill" align-items="stretch">
    <hbox id="topbar" width="100%" height="36" gap="8" padding="6" background="#EAE0D0" border-width="0" align-items="center">
      <button id="back" text="Back" icon="arrow-left" icon-set="lucide" action="route:pop" background="#F5EFE6" color="#1C1917" width="72" height="24" radius="8" border-width="0" component="button" font-family="Inter" font-size="12"/>
      <label id="title" text="App Launcher" color="#1C1917" width="fill" height="wrap" grow="1" font-family="DM Sans" font-size="14" font-weight="700" component="header"/>
      <label id="clock" text="00:00" color="#57534E" width="auto" height="wrap" value="1" font-family="JetBrains Mono" font-size="13"/>
    </hbox>
    <flex id="body" class="col gap-8 p-12" width="100%" height="fill" grow="1" align-items="stretch">
      <input id="search" text="" width="100%" height="36" background="#EAE0D0" color="#1C1917" radius="10" border-width="0" padding="10" font-family="Inter" font-size="13" component="input"/>
      <grid id="drawer" width="100%" height="fill" grow="1" gap="10" padding="4" columns="6">
        <button id="app0" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app1" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app2" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app3" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app4" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app5" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app6" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app7" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app8" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app9" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app10" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
        <button id="app11" text="App" icon="app" icon-set="lucide" action="none" background="#EAE0D0" color="#1C1917" radius="14" border-width="0" component="tile" font-family="Inter" font-size="11"/>
      </grid>
    </flex>
    <hbox id="taskbar" width="100%" height="48" gap="6" padding="6" background="#EAE0D0" border-width="0">
      <button id="start" text="" icon="home" icon-set="lucide" action="home" background="#EA580C" color="#FFFFFF" width="36" height="36" radius="10" border-width="0" component="button"/>
      <label id="hint" text="Installed .vpkg apps" color="#57534E" width="fill" height="wrap" grow="1" font-family="Inter" font-size="12"/>
    </hbox>
  </flex>
</screen>
