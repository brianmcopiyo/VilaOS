fn apps
  system.packages.list title
  ui.set_text title Apps
endfn

fn filter
  vapi filter_q ui.get_text search
  if eq $filter_q ""
    invoke apps _
  else
    concat _t0 "Apps: " $filter_q
    ui.set_text title $_t0
  endif
endfn

fn home
  system.time clock
  clock.date date
  ui.set_text statuspill VilaOS
  ui.set_text drawer "Search apps"
endfn

fn loadPrefs
  vapi loadPrefs_s storage.app.get sound
  if ne $loadPrefs_s ""
    let g_sound $loadPrefs_s
  endif
  vapi loadPrefs_v storage.app.get vibrate
  if ne $loadPrefs_v ""
    let g_vibrate $loadPrefs_v
  endif
endfn

fn lock
  system.time clock
  clock.date date
  ui.set_text note1 "2 messages"
  ui.set_text note2 "1 missed call"
endfn

fn tasks
  ui.set_text title Recents
endfn

fn empty
  ui.set_text r0 "— cleared"
  ui.set_text r1 "— cleared"
  ui.set_text r2 "— cleared"
  ui.set_text r3 "— cleared"
  ui.set_text r4 "— cleared"
  ui.set_text r5 "— cleared"
endfn

fn panel sound vibrate
  system.time clock
  system.device.info device
  system.memory.info memory
  if eq $sound 1
    ui.set_text sound "Sound: On"
  else
    ui.set_text sound "Sound: Off"
  endif
  if eq $vibrate 1
    ui.set_text vibrate "Vibrate: On"
  else
    ui.set_text vibrate "Vibrate: Off"
  endif
  storage.app.set sound $sound
  storage.app.set vibrate $vibrate
endfn

on_load
  if eq $g_sound ""
    let g_sound 1
  endif
  if eq $g_vibrate ""
    let g_vibrate 1
  endif
  require ui
  require system.device
  require system.power
  require storage.app
  require storage.files
  invoke loadPrefs _
end

on_tick
  system.time clock
  system.memory.info memory
  clock.date date
end

on_action search
  invoke filter _
end

on_action clear
  invoke empty _
end

on_action unlock
  ui.replace res/layout/home.xml
end

on_action shade
  invoke panel _ $g_sound $g_vibrate
  ui.push res/layout/shade.xml
end

on_action drawer
  invoke apps _
  ui.push res/layout/drawer.xml
end

on_action toggle_sound
  if eq $g_sound 1
    let g_sound 0
  else
    let g_sound 1
  endif
  invoke panel _ $g_sound $g_vibrate
end

on_action toggle_vibrate
  if eq $g_vibrate 1
    let g_vibrate 0
  else
    let g_vibrate 1
  endif
  invoke panel _ $g_sound $g_vibrate
end

on_action power_menu
  system.power.menu _
end

on_action recent_0
  ui.pop _
end

on_action recent_1
  ui.pop _
end

on_action recent_2
  ui.pop _
end

on_action recent_3
  ui.pop _
end

on_action recent_4
  ui.pop _
end

on_action recent_5
  ui.pop _
end

on_soft left
  invoke filter _
  invoke empty _
end

on_soft center
end

on_soft right
end
