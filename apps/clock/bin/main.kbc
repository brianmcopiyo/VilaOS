fn fmt sec
  toint fmt_s $sec
  div fmt_m $fmt_s 60
  mod fmt_r $fmt_s 60
  tostr fmt_ms $fmt_m
  tostr fmt_rs $fmt_r
  if lt $fmt_m 10
    concat fmt_ms 0 $fmt_ms
  endif
  if lt $fmt_r 10
    concat fmt_rs 0 $fmt_rs
  endif
  concat _t0 $fmt_ms :
  concat _t1 $_t0 $fmt_rs
  ret $_t1
endfn

on_load
  if eq $g_sw_run ""
    let g_sw_run 0
  endif
  if eq $g_sw_sec ""
    let g_sw_sec 0
  endif
  if eq $g_tm_run ""
    let g_tm_run 0
  endif
  if eq $g_tm_sec ""
    let g_tm_sec 60
  endif
  if eq $g_tick ""
    let g_tick 0
  endif
  require ui
  require system.clock
  clock.now clock_now
  invoke fmt _t2 $g_sw_sec
  ui.set_text stopwatch_time $_t2
  invoke fmt _t2 $g_tm_sec
  ui.set_text timer_time $_t2
end

on_tick
  clock.now clock_now
  toint _t2 $g_tick
  add _t3 $_t2 1
  tostr g_tick $_t3
  toint _t2 $g_tick
  if ge $_t2 5
    let g_tick 0
    if eq $g_sw_run 1
      toint _t3 $g_sw_sec
      add _t4 $_t3 1
      tostr g_sw_sec $_t4
      invoke fmt _t3 $g_sw_sec
      ui.set_text stopwatch_time $_t3
    endif
    if eq $g_tm_run 1
      toint _t3 $g_tm_sec
      if gt $_t3 0
        toint _t4 $g_tm_sec
        sub _t5 $_t4 1
        tostr g_tm_sec $_t5
        invoke fmt _t4 $g_tm_sec
        ui.set_text timer_time $_t4
      else
        let g_tm_run 0
      endif
    endif
  endif
end

on_action sw_start
  let g_sw_run 1
end

on_action sw_stop
  let g_sw_run 0
end

on_action sw_reset
  let g_sw_run 0
  let g_sw_sec 0
  invoke fmt _t2 $g_sw_sec
  ui.set_text stopwatch_time $_t2
end

on_action tm_start
  let g_tm_run 1
end

on_action tm_stop
  let g_tm_run 0
end

on_action tm_reset
  let g_tm_run 0
  let g_tm_sec 60
  invoke fmt _t2 $g_tm_sec
  ui.set_text timer_time $_t2
end

on_action tm_plus
  toint _t2 $g_tm_sec
  add _t3 $_t2 30
  tostr g_tm_sec $_t3
  invoke fmt _t2 $g_tm_sec
  ui.set_text timer_time $_t2
end

on_soft left
  let g_sw_run 1
end

on_soft right
  ui.pop
end
