on_load
  require messages
end

on_click m1
  push_route res/layout/thread.xml
end
on_click m2
  push_route res/layout/thread.xml
end
on_click m3
  push_route res/layout/thread.xml
end
on_click m4
  push_route res/layout/thread.xml
end
on_click newmsg
  push_route res/layout/compose.xml
end

on_soft left
  push_route res/layout/compose.xml
end

on_soft right
  pop_route
end
