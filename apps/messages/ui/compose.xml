<?xml version="1.0"?>
<screen id="compose" bg="#0B0F17">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="title" text="New message" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="mode_badge" text="[T9: abc]" fg="#94A3B8" w="100%" h="auto"/>
    <label id="to_lbl" text="To" fg="#94A3B8" w="100%" h="auto"/>
    <input id="to" text="" max_len="32" w="100%" h="auto" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
    <label id="body_lbl" text="Message" fg="#94A3B8" w="100%" h="auto"/>
    <input id="msg" text="" max_len="120" w="100%" h="auto" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
    <label id="msgstatus" text="Ready" fg="#16A34A" w="100%" h="auto"/>
  </vbox>
  <softkeys left="Send" center="OK" right="Back"
            left_action="send" center_action="send" right_action="back"/>
</screen>
