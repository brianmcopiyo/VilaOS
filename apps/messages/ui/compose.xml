<?xml version="1.0"?>
<screen id="compose" bg="#F5EFE6">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="title" text="New message" fg="#1C1917" w="100%" h="auto"/>
    <label id="mode_badge" text="[T9: abc]" fg="#57534E" w="100%" h="auto"/>
    <label id="to_lbl" text="To" fg="#57534E" w="100%" h="auto"/>
    <input id="to" text="" max_len="32" w="100%" h="auto" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
    <label id="body_lbl" text="Message" fg="#57534E" w="100%" h="auto"/>
    <input id="msg" text="" max_len="120" w="100%" h="auto" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
    <label id="msgstatus" text="Ready" fg="#15803D" w="100%" h="auto"/>
  </vbox>
  <softkeys left="Send" center="OK" right="Back"
            left_action="send" center_action="send" right_action="route:pop"/>
</screen>
