on_click send_btn
  let body text:msg_input
  if ne $body ""
    messages.send $body msgstatus
    ui.clear_text msg_input
  endif
end

on_click m1
  messages.open
end

on_click m2
  messages.open
end

on_click m3
  messages.open
end

on_click m4
  messages.open
end

on_click c1
  messages.open
end

on_click c2
  messages.open
end

on_click c3
  messages.open
end

on_click c4
  messages.open
end

on_click c5
  messages.open
end

on_load
  require ui
  require messages
end

on_action send
  vapi body ui.get_text msg_input
  if eq $body ""
    vapi alt ui.get_text msg
    if ne $alt ""
      messages.send $alt msgstatus
    endif
  else
    messages.send $body msgstatus
    ui.clear_text msg_input
  endif
end

on_soft left
  messages.compose
end

on_soft center
  messages.open
end

on_soft right
  ui.pop
end
