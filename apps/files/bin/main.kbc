on_load
  require ui
  require storage.files
  storage.files.list . file_preview
end

on_action preview
  vapi name ui.get_text file_preview
  concat _t0 "Preview: " $name
  ui.set_text file_preview $_t0
end

on_soft left
  vapi name ui.get_text file_preview
  concat _t0 "Preview: " $name
  ui.set_text file_preview $_t0
end

on_soft right
  ui.pop
end
