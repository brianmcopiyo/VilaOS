<?xml version="1.0"?>
<screen id="files" bg="#F5EFE6">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="title" text="Files" fg="#1C1917" w="100%" h="auto"/>
    <label id="path_lbl" text="/Documents" fg="#57534E" w="100%" h="auto"/>
    <list id="entries" w="100%" h="auto" bg="#EAE0D0">
      <button id="f1" text="Photos/  dir" action="preview" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
      <button id="f2" text="Notes/  dir" action="preview" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
      <button id="f3" text="readme.txt  2 KB" action="preview" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
      <button id="f4" text="budget.csv  8 KB" action="preview" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
      <button id="f5" text="voice01.amr  24 KB" action="preview" bg="#EAE0D0" fg="#1C1917" focus_bg="#EA580C"/>
    </list>
    <label id="file_preview" text="Select a file" fg="#57534E" w="100%" h="auto"/>
  </vbox>
  <softkeys left="Open" center="OK" right="Back"
            left_action="preview" center_action="ok" right_action="route:pop"/>
</screen>
