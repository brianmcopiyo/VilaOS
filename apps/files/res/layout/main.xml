      <button id="f4" text="budget.csv  8 KB" action="preview" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
      <button id="f5" text="voice01.amr  24 KB" action="preview" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
