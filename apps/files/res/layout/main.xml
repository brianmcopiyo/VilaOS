<?xml version="1.0"?>
<screen id="files" bg="#0B0F17">
  <statusbar id="status"/>
  <vbox id="body" x="0%" y="auto" w="100%" h="auto">
    <label id="title" text="Files" fg="#F1F5F9" w="100%" h="auto"/>
    <label id="path_lbl" text="/Documents" fg="#94A3B8" w="100%" h="auto"/>
    <list id="entries" w="100%" h="auto" bg="#151C28">
      <button id="f1" text="Photos/  dir" action="preview" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
      <button id="f2" text="Notes/  dir" action="preview" bg="#151C28" fg="#F1F5F9" focus_bg="#1E40AF"/>
