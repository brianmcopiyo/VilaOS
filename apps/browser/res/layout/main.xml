<?xml version="1.0"?>
<screen id="browser" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="6" align="stretch">
    <label id="title" text="Browser" color="#1C1917" width="100%" height="wrap"/>
    <input id="url" text="file:///apps/browser/res/layout/main.xml" width="100%" height="36" background="#EAE0D0" color="#1C1917" radius="10" border-width="1" border-color="#D4C5B0" padding="8"/>
    <list id="pages" width="100%" height="fill" grow="1" min-height="100" padding="4" gap="4" radius="8" background="#EAE0D0" border-width="1" border-color="#D4C5B0">
      <button id="p1" text="VilaOS Welcome" action="none" background="#EAE0D0" color="#1C1917" radius="10" height="40" component="list_row"/>
      <button id="p2" text="App Manifest Spec" action="none" background="#EAE0D0" color="#1C1917" radius="10" height="40" component="list_row"/>
      <button id="p3" text="VSL Quick Reference" action="none" background="#EAE0D0" color="#1C1917" radius="10" height="40" component="list_row"/>
    </list>
    <label id="page_view" text="Select a page to read" color="#57534E" width="100%" height="44" background="#EAE0D0" radius="8" padding="8"/>
  </flex>
  <softkeys left="Open" center="OK" right="Back"
            left-action="ok" center-action="ok" right-action="route:pop"/>
</screen>
