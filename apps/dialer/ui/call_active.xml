<?xml version="1.0"?>
<screen id="call_active" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="8" align="stretch">
    <label id="call_title" text="Active call" color="#57534E" width="100%" height="wrap" component="section_header"/>
    <label id="call_name" text="Calling..." color="#1C1917" width="100%" height="40" value="1"/>
    <label id="call_number" text="" color="#57534E" width="100%" height="wrap"/>
    <label id="call_timer" text="00:00" color="#15803D" width="100%" height="wrap" value="1"/>
    <hbox id="call_actions" width="100%" height="auto" gap="6">
      <button id="btn_mute" text="Mute" action="mute" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
      <button id="btn_speaker" text="Speaker" action="speaker" background="#EAE0D0" color="#1C1917" width="auto" height="40" radius="10" grow="1"/>
    </hbox>
    <button id="btn_end" text="End Call" action="end_call" background="#B91C1C" color="#FFFFFF" width="100%" height="44" radius="12"/>
  </flex>
  <softkeys left="Mute" center="Speaker" right="End"
            left-action="mute" center-action="speaker" right-action="end_call"/>
</screen>
