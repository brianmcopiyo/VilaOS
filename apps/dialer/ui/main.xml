<?xml version="1.0"?>
<screen id="dialer" class="page">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <input id="number" text="" width="100%" height="44" class="surface" color="#1C1917" radius="10" border-width="1" border-color="#D4C5B0" padding="8" font-family="JetBrains Mono" font-size="16" placeholder="Number"/>
    <label id="contact_match" text="Enter a number" class="text-secondary" width="100%" height="wrap" font-family="Inter" font-size="12"/>
    <keypad id="dialpad" width="100%" height="auto"/>
    <button id="btn_call" variant="primary" text="Call" icon="phone" icon-set="lucide" action="call" width="100%" height="44" border-radius="12" font-family="DM Sans" font-weight="700" component="button"/>
  </flex>
  <softkeys left="Call" center="OK" right="Clear"
            left-action="call" center-action="call" right-action="clear"/>
</screen>
