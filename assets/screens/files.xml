<?xml version="1.0"?>
<screen id="files" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="6" align="stretch">
    <label id="title" text="Files" color="#1C1917" width="100%" height="wrap"/>
    <label id="path_lbl" text="/Documents" color="#57534E" width="100%" height="wrap"/>
    <list id="entries" width="100%" height="fill" grow="1" min-height="100" padding="6" gap="4" radius="8" background="#EAE0D0" border-width="1" border-color="#D4C5B0" margin="0 0 6 0">
      <button id="f1" text="Photos/  dir" action="preview" background="#EAE0D0" color="#1C1917" radius="8" height="40" component="file_row" font-family="JetBrains Mono" font-size="12"/>
      <button id="f2" text="Notes/  dir" action="preview" background="#EAE0D0" color="#1C1917" radius="8" height="40" component="file_row" font-family="JetBrains Mono" font-size="12"/>
      <button id="f3" text="readme.txt  2 KB" action="preview" background="#EAE0D0" color="#1C1917" radius="8" height="40" component="file_row" font-family="JetBrains Mono" font-size="12"/>
      <button id="f4" text="budget.csv  8 KB" action="preview" background="#EAE0D0" color="#1C1917" radius="8" height="40" component="file_row" font-family="JetBrains Mono" font-size="12"/>
      <button id="f5" text="voice01.amr  24 KB" action="preview" background="#EAE0D0" color="#1C1917" radius="8" height="40" component="file_row" font-family="JetBrains Mono" font-size="12"/>
    </list>
    <label id="file_preview" text="Select a file" color="#1C1917" background="#EAE0D0" width="100%" height="44" min-height="40" max-height="52" padding="8" radius="8"/>
  </flex>
  <softkeys left="Open" center="OK" right="Back"
            left-action="preview" center-action="ok" right-action="route:pop"/>
</screen>
