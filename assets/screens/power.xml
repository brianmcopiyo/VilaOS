<?xml version="1.0"?>
<screen id="power" background="#F5EFE6">
 <statusbar id="status"/>
 <vbox id="body" x="0%" y="auto" width="100%" height="auto">
 <label id="title" text="Power" color="#1C1917" width="100%" height="auto"/>
 <label id="hint" text="Choose an action" color="#57534E" width="100%" height="auto"/>
 <button id="pwr_off" text="Power Off" action="power_off" background="#B91C1C" color="#FFFFFF" width="100%" height="auto"/>
 <button id="pwr_restart" text="Restart" action="power_restart" background="#EAE0D0" color="#1C1917" width="100%" height="auto"/>
 <button id="pwr_cancel" text="Cancel" action="power_cancel" background="#EAE0D0" color="#1C1917" width="100%" height="auto"/>
 </vbox>
 <softkeys left="Select" center="OK" right="Cancel"
 left-action="ok" center-action="ok" right-action="power_cancel"/>
</screen>
