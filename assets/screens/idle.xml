<?xml version="1.0"?>
<screen id="idle" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="12" gap="8" align="stretch">
    <label id="idle_clock" text="00:00" color="#1C1917" width="100%" height="72" value="1" font-family="JetBrains Mono" font-size="28" font-weight="500"/>
    <label id="idle_date" text="Today" color="#57534E" width="100%" height="wrap" font-family="DM Sans" font-size="14" font-weight="600"/>
    <label id="pill1" text="2 messages" color="#FFFFFF" background="#EA580C" width="auto" height="24" value="2" radius="12" font-family="Inter" font-size="12"/>
    <label id="pill2" text="1 missed call" color="#FFFFFF" background="#EA580C" width="auto" height="24" value="2" radius="12" font-family="Inter" font-size="12"/>
    <label id="idle_hint" text="Press Unlock to open VilaOS" color="#57534E" width="100%" height="wrap" font-family="Inter" font-size="12"/>
  </flex>
  <softkeys left="Menu" center="Unlock" right="Dial"
            left-action="menu" center-action="unlock" right-action="nav:assets/screens/dialer.xml"/>
</screen>
