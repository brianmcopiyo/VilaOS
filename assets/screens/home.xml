<?xml version="1.0"?>
<screen id="home" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" direction="column" x="0%" y="auto" width="100%" height="fill" padding="8" gap="6" align="stretch">
    <label id="title" text="VilaOS" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="18" font-weight="700"/>
    <label id="pill_status" text="Ready" icon="check" icon-set="lucide" value="2" width="auto" height="24" background="#EA580C" color="#FFFFFF" radius="12" component="badge" font-family="Inter" font-size="12"/>
    <label id="subtitle" text="Apps" color="#57534E" width="100%" height="wrap" component="header" font-family="DM Sans" font-size="13" font-weight="600"/>
    <grid id="launcher" width="100%" height="fill" grow="1" gap="8" padding="2" columns="0">
      <button id="app_dialer" text="Dialer" icon="dialer" icon-set="lucide" action="app:dialer" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_messages" text="Messages" icon="messages" icon-set="phosphor" action="app:messages" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_contacts" text="Contacts" icon="contacts" icon-set="tabler" action="app:contacts" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_notes" text="Notes" icon="notes" icon-set="lucide" action="app:notes" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_calc" text="Calculator" icon="calculator" icon-set="tabler" action="app:calculator" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_clock" text="Clock" icon="clock" icon-set="phosphor" action="app:clock" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_files" text="Files" icon="files" icon-set="lucide" action="app:files" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_browser" text="Browser" icon="browser" icon-set="lucide" action="app:browser" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_settings" text="Settings" icon="settings" icon-set="tabler" action="app:settings" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
      <button id="app_music" text="Music" icon="music" icon-set="phosphor" action="app:music" background="#EAE0D0" color="#1C1917" radius="10" component="tile" font-family="Inter" font-size="11"/>
    </grid>
  </flex>
  <softkeys left="Options" center="OK" right="Lock"
            left-action="power_menu" center-action="ok" right-action="lock"/>
</screen>
