<?xml version="1.0"?>
<screen id="settings" class="page" background="#F5EFE6">
  <statusbar id="status"/>
  <flex id="body" class="col gap-6 p-8" x="0%" y="auto" width="100%" height="fill" align-items="stretch">
    <label id="title" text="Settings" color="#1C1917" width="100%" height="wrap" font-family="DM Sans" font-size="18" font-weight="700"/>
    <input id="search" text="" width="100%" height="36" background="#EAE0D0" color="#1C1917" radius="10" border-width="1" border-color="#D4C5B0" padding="8"/>
    <card class="row items-center justify-between p-8">
      <row id="sum_device" title="VilaOS" subtitle="Device" icon="settings" icon-set="tabler"/>
      <badge id="sum_api" text="API"/>
    </card>
    <list id="sections" width="100%" height="fill" grow="1" min-height="120" class="surface" padding="4" gap="4" overflow="scroll">
      <row id="sec_display" title="Display" subtitle="Theme and typography" icon="monitor" icon-set="lucide" action="app:settings"/>
      <row id="sec_input" title="Input" subtitle="Touch and keypad" icon="keyboard" icon-set="lucide" action="app:settings"/>
      <row id="sec_apps" title="Apps" subtitle="Installed packages" icon="package" icon-set="lucide" action="app:settings"/>
      <row id="sec_services" title="Services" subtitle="Background tasks" icon="activity" icon-set="lucide" action="app:settings"/>
      <row id="sec_system" title="System" subtitle="Memory and power" icon="info" icon-set="lucide" action="app:settings"/>
    </list>
  </flex>
  <softkeys left="Open" center="OK" right="Back"
            left-action="ok" center-action="ok" right-action="route:pop"/>
</screen>
