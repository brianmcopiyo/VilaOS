<?xml version="1.0"?>
<screen id="compose" background="#F5EFE6">
 <statusbar id="status"/>
 <vbox id="body" x="0%" y="auto" width="100%" height="auto">
 <label id="title" text="New message" color="#1C1917" width="100%" height="auto"/>
 <label id="mode_badge" text="[T9: abc]" color="#57534E" width="100%" height="auto"/>
 <label id="to_lbl" text="To" color="#57534E" width="100%" height="auto"/>
 <input id="to" text="" width="100%" height="auto" background="#EAE0D0" color="#1C1917"/>
 <label id="body_lbl" text="Message" color="#57534E" width="100%" height="auto"/>
 <input id="msg" text="" width="100%" height="auto" background="#EAE0D0" color="#1C1917"/>
 <label id="msgstatus" text="Ready" color="#15803D" width="100%" height="auto"/>
 </vbox>
 <softkeys left="Send" center="OK" right="Back"
 left-action="send" center-action="send" right-action="back"/>
</screen>
